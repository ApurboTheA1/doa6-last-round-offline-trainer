          <ID>12</ID>
          <Description>"Max Arcade / Survival Score (Hook)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
doa6lr_assert_offline()
{$asm}
aobscanmodule(INJ_SCOREMUL,DOA6LR.exe,?? ?? ?? ?? ?? ?? ?? ?? 48 C7 83 60 01 00 00 00 00 00 00 48 01 83 68 01 00 00 48 83)
alloc(newmem_score,256,INJ_SCOREMUL)
globalalloc(DOA6LR_ScoreTaskPtr,8,DOA6LR.exe)
globalalloc(DOA6LR_ScoreMultVal,4,DOA6LR.exe)
globalalloc(DOA6LR_ScoreMaxMode,4,DOA6LR.exe)
label(return_score)

DOA6LR_ScoreMultVal:
  dd 0A

DOA6LR_ScoreMaxMode:
  dd 01

newmem_score:
  mov [DOA6LR_ScoreTaskPtr], rbx
  imul rax, [rbx+160]
  push rcx
  mov ecx, [DOA6LR_ScoreMultVal]
  cmp ecx, 01
  jle short score_chk_max
  movsxd rcx, ecx
  imul rax, rcx
score_chk_max:
  cmp dword ptr [DOA6LR_ScoreMaxMode], 00
  je short score_done
  mov eax, 05F5E0FF
score_done:
  pop rcx
  jmp return_score

INJ_SCOREMUL:
  jmp newmem_score
  nop 3
return_score:
registersymbol(INJ_SCOREMUL)

[DISABLE]
INJ_SCOREMUL:
  db 48 0F AF 83 60 01 00 00

unregistersymbol(INJ_SCOREMUL)
dealloc(newmem_score)
</AssemblerScript>
