  <UserdefinedSymbols/>
  <LuaScript>-- DOA6 Last Round (DOA6LR.exe) Dynamic Symbol &amp; Offline Safety Script
local TARGET_PROC = "DOA6LR.exe"
local initialized = false
local lastP1, lastP2 = 0, 0
local dmgState = { p1_inf = false, p2_ohko = false, hookInstalled = false }
local brkState = { p1_max = false, p2_empty = false, hookInstalled = false }

local function aob_first(pattern)
  local res = AOBScanModule(TARGET_PROC, pattern)
  if res and res.Count &gt; 0 then
    local addr = getAddressSafe(res[0])
    res.destroy()
    return addr
  end
  if res then res.destroy() end
  return nil
end

local function rip_target(inst_addr, op_len)
  if not inst_addr then return nil end
  local disp = readInteger(inst_addr + op_len, true)
  if not disp then return nil end
  return inst_addr + op_len + 4 + disp
end

local function read_fighter_node(node_ptr, expected_key)
  if not node_ptr or node_ptr == 0 then return 0 end
  if readBytes(node_ptr + 0x19, 1, false) ~= 0 then return 0 end
  if readBytes(node_ptr + 0x20, 1, false) ~= expected_key then return 0 end
  local slot = readQword(node_ptr + 0x28)
  if not slot or slot == 0 then return 0 end
  return readQword(slot + 0x88) or 0
end

local function sync_fighter_symbol(sym_name, cached, value)
  if value ~= cached then
    unregisterSymbol(sym_name)
    if value ~= 0 then registerSymbol(sym_name, value) end
  end
  return value
end

function doa6lr_isOffline()
  local online_ptr_sym = getAddressSafe("DOA6LR_OnlineObjPtr")
  if not online_ptr_sym or online_ptr_sym == 0 then return true end
  local obj = readQword(online_ptr_sym)
  if not obj or obj == 0 then return true end
  local flag = readBytes(obj + 0x8F8, 1, false)
  if not flag then return true end
  return flag &gt;= 5
end

function doa6lr_assert_offline()
  doa6lr_init()
  if not doa6lr_isOffline() then
    error("Offline safety guard: Online mode detected (flag &lt; 5). Cheats are blocked online.")
  end
end

function doa6lr_update_fighters()
  local fmap_sym = getAddressSafe("DOA6LR_FighterMapPtr")
  if not fmap_sym or fmap_sym == 0 then return end
  local fmap = readQword(fmap_sym)
  local head = (fmap and fmap ~= 0) and readQword(fmap) or 0
  local p1, p2 = 0, 0
  if head and head ~= 0 then
    p1 = read_fighter_node(readQword(head + 0x00), 0)
    p2 = read_fighter_node(readQword(head + 0x10), 1)
  end
  lastP1 = sync_fighter_symbol("DOA6LR_P1Fighter", lastP1, p1)
  lastP2 = sync_fighter_symbol("DOA6LR_P2Fighter", lastP2, p2)
end

function doa6lr_init()
  if getOpenedProcessID() == 0 then
    local pid = getProcessIDFromProcessName(TARGET_PROC)
    if not pid or pid == 0 then return false end
    openProcess(pid)
  end

  if initialized and getAddressSafe("DOA6LR_FighterMapPtr") then
    doa6lr_update_fighters()
    return true
  end

  local owner_aob = aob_first("48 8B 05 ?? ?? ?? ?? 48 83 C4 38 C3 48 8D 0D 30")
  local reward_aob = aob_first("48 8B 05 ?? ?? ?? ?? 8B 40 10 48 83 C4 28")
  local fmap_aob = aob_first("48 8B 05 ?? ?? ?? ?? 48 85 C0 75 22 48 89 37 48")
  local score_aob = aob_first("48 8B 05 ?? ?? ?? ?? 8B 90 10 05 00 00 33 C0 89 54 24 38 83 7C 84 38 00 75 27")
  local online_aob = aob_first("48 8B 05 ?? ?? ?? ?? 48 85 C0 74 11 0F B6 80 F8 08 00 00 3C 01 0F 94 C0 48 83 C4 28 C3 B0 FF")
  local save_call_aob = aob_first("E8 ?? ?? ?? ?? 48 8B 0D ?? ?? ?? ?? 44 8B C3 48 83 C1 78 BA 5E F5 4B 4F 48 8B F8 E8 ?? ?? ?? ?? 48 98 48 83 F8 64")

  if not (owner_aob and reward_aob and fmap_aob and score_aob and online_aob and save_call_aob) then
    return false
  end

  local rel_save = readInteger(save_call_aob + 1, true)
  local get_save_fn = save_call_aob + 5 + rel_save
  local save_ptr = nil
  for off = 0x20, 0x50 do
    local b0, b1, b2 = readBytes(get_save_fn + off, 3)
    if b0 == 0x48 and b1 == 0x8B and b2 == 0x05 then
      save_ptr = rip_target(get_save_fn + off, 3)
      break
    end
  end
  if not save_ptr then return false end

  registerSymbol("DOA6LR_OwnerPtr", rip_target(owner_aob, 3))
  registerSymbol("DOA6LR_RewardPtr", rip_target(reward_aob, 3))
  registerSymbol("DOA6LR_FighterMapPtr", rip_target(fmap_aob, 3))
  registerSymbol("DOA6LR_ScoreGlobalPtr", rip_target(score_aob, 3))
  registerSymbol("DOA6LR_OnlineObjPtr", rip_target(online_aob, 3))
  registerSymbol("DOA6LR_SaveDataPtr", save_ptr)

  initialized = true
  unregisterSymbol("DOA6LR_P1Fighter")
  unregisterSymbol("DOA6LR_P2Fighter")
  lastP1, lastP2 = 0, 0
  doa6lr_update_fighters()
  return true
end

local DMG_HOOK_ENABLE = [[
aobscanmodule(INJ_APPLYDMG,DOA6LR.exe,?? ?? ?? ?? ?? ?? ?? 44 3B F0 41 0F 9D C4 43 8D 0C 3E 3B C8 89 4E 20 0F 9D 45 67 7C 05 89 46 20 8B C8 85 C9 79 05 89 56 20 8B CA 83 7E 18 02)
alloc(newmem_dmg,512,INJ_APPLYDMG)
globalalloc(DOA6LR_DmgCfg,16,DOA6LR.exe)
label(dmg_chk_p2)
label(dmg_done)
label(return_dmg)

DOA6LR_DmgCfg:
  dd 00
  dd 00

newmem_dmg:
  mov r14d, [rsi+20]
  mov eax, [rsi+1C]
  push rcx
  push rdx
  mov rcx, [DOA6LR_OnlineObjPtr]
  test rcx, rcx
  jz dmg_online_ok
  cmp byte ptr [rcx+8F8], 05
  jb dmg_done
dmg_online_ok:
  mov rcx, [DOA6LR_FighterMapPtr]
  test rcx, rcx
  jz dmg_done
  mov rcx, [rcx]
  test rcx, rcx
  jz dmg_done
  cmp dword ptr [DOA6LR_DmgCfg], 00
  je dmg_chk_p2
  mov rdx, [rcx]
  test rdx, rdx
  jz dmg_chk_p2
  cmp byte ptr [rdx+19], 00
  jne dmg_chk_p2
  cmp byte ptr [rdx+20], 00
  jne dmg_chk_p2
  mov rdx, [rdx+28]
  test rdx, rdx
  jz dmg_chk_p2
  mov rdx, [rdx+88]
  cmp rdx, [rsi+08]
  jne dmg_chk_p2
  xor r14d, r14d
  xor r15d, r15d
  jmp dmg_done
dmg_chk_p2:
  cmp dword ptr [DOA6LR_DmgCfg+04], 00
  je dmg_done
  test r15d, r15d
  jle dmg_done
  mov rdx, [rcx+10]
  test rdx, rdx
  jz dmg_done
  cmp byte ptr [rdx+19], 00
  jne dmg_done
  cmp byte ptr [rdx+20], 01
  jne dmg_done
  mov rdx, [rdx+28]
  test rdx, rdx
  jz dmg_done
  mov rdx, [rdx+88]
  cmp rdx, [rsi+08]
  jne dmg_done
  mov r15d, eax
dmg_done:
  pop rdx
  pop rcx
  jmp return_dmg

INJ_APPLYDMG:
  jmp newmem_dmg
  nop 2
return_dmg:
registersymbol(INJ_APPLYDMG)
]]

local DMG_HOOK_DISABLE = [[
INJ_APPLYDMG:
  db 44 8B 76 20 8B 46 1C
unregistersymbol(INJ_APPLYDMG)
dealloc(newmem_dmg)
]]

local BRK_HOOK_ENABLE = [[
aobscanmodule(INJ_BRKHELPER,DOA6LR.exe,?? ?? ?? ?? ?? ?? ?? 66 89 3B 74 0C 66 85 FF 75 07 0F B7 43 02 66)
alloc(newmem_brk,512,INJ_BRKHELPER)
globalalloc(DOA6LR_BrkCfg,16,DOA6LR.exe)
label(brk_fmap)
label(brk_chk_p2)
label(brk_done)
label(return_brk)

DOA6LR_BrkCfg:
  dd 00
  dd 00

newmem_brk:
  push rax
  push rcx
  push rdx
  mov rcx, [DOA6LR_OnlineObjPtr]
  test rcx, rcx
  jz brk_fmap
  cmp byte ptr [rcx+8F8], 05
  jb brk_done
brk_fmap:
  mov rcx, [DOA6LR_FighterMapPtr]
  test rcx, rcx
  jz brk_done
  mov rcx, [rcx]
  test rcx, rcx
  jz brk_done
  lea rax, [rbx-580]
  cmp dword ptr [DOA6LR_BrkCfg], 00
  je brk_chk_p2
  mov rdx, [rcx]
  test rdx, rdx
  jz brk_chk_p2
  cmp byte ptr [rdx+19], 00
  jne brk_chk_p2
  cmp byte ptr [rdx+20], 00
  jne brk_chk_p2
  mov rdx, [rdx+28]
  test rdx, rdx
  jz brk_chk_p2
  cmp rax, [rdx+88]
  jne brk_chk_p2
  movzx edi, word ptr [rbx+02]
  jmp brk_done
brk_chk_p2:
  cmp dword ptr [DOA6LR_BrkCfg+04], 00
  je brk_done
  mov rdx, [rcx+10]
  test rdx, rdx
  jz brk_done
  cmp byte ptr [rdx+19], 00
  jne brk_done
  cmp byte ptr [rdx+20], 01
  jne brk_done
  mov rdx, [rdx+28]
  test rdx, rdx
  jz brk_done
  cmp rax, [rdx+88]
  jne brk_done
  xor edi, edi
brk_done:
  pop rdx
  pop rcx
  pop rax
  cmp byte ptr [rbx+06], 00
  movzx eax, di
  jmp return_brk

INJ_BRKHELPER:
  jmp newmem_brk
  nop 2
return_brk:
registersymbol(INJ_BRKHELPER)
]]

local BRK_HOOK_DISABLE = [[
INJ_BRKHELPER:
  db 80 7B 06 00 0F B7 C7
unregistersymbol(INJ_BRKHELPER)
dealloc(newmem_brk)
]]

local function write_p1_health(p1)
  if p1 and p1 ~= 0 then
    writeInteger(p1 + 0x1758, 0)
    writeQword(p1 + 0x5B4, 0)
  end
end

local function write_p1_break(p1, mx)
  if p1 and p1 ~= 0 and mx and mx &gt; 0 then
    writeSmallInteger(p1 + 0x580, mx)
  end
end

local function write_p2_break(p2)
  if p2 and p2 ~= 0 then
    writeSmallInteger(p2 + 0x580, 0)
  end
end

function doa6lr_set_dmg_flag(key, enabled)
  if enabled then
    doa6lr_assert_offline()
    if not dmgState.hookInstalled then
      local ok, err = autoAssemble(DMG_HOOK_ENABLE)
      if not ok then error("Damage hook failed: " .. tostring(err)) end
      dmgState.hookInstalled = true
    end
  end
  dmgState[key] = enabled and true or false
  local cfg = getAddressSafe("DOA6LR_DmgCfg")
  if cfg and cfg ~= 0 then
    writeInteger(cfg, dmgState.p1_inf and 1 or 0)
    writeInteger(cfg + 4, dmgState.p2_ohko and 1 or 0)
  end
  if dmgState.p1_inf then pcall(write_p1_health, lastP1 &gt; 0 and lastP1 or getAddressSafe("DOA6LR_P1Fighter")) end
  if not dmgState.p1_inf and not dmgState.p2_ohko and dmgState.hookInstalled then
    autoAssemble(DMG_HOOK_DISABLE)
    dmgState.hookInstalled = false
  end
end

function doa6lr_set_brk_flag(key, enabled)
  if enabled then
    doa6lr_assert_offline()
    if not brkState.hookInstalled then
      local ok, err = autoAssemble(BRK_HOOK_ENABLE)
      if not ok then error("Break hook failed: " .. tostring(err)) end
      brkState.hookInstalled = true
    end
  end
  brkState[key] = enabled and true or false
  local cfg = getAddressSafe("DOA6LR_BrkCfg")
  if cfg and cfg ~= 0 then
    writeInteger(cfg, brkState.p1_max and 1 or 0)
    writeInteger(cfg + 4, brkState.p2_empty and 1 or 0)
  end
  if brkState.p1_max then pcall(doa6lr_refill_p1_break) end
  if brkState.p2_empty then pcall(write_p2_break, lastP2 &gt; 0 and lastP2 or getAddressSafe("DOA6LR_P2Fighter")) end
  if not brkState.p1_max and not brkState.p2_empty and brkState.hookInstalled then
    autoAssemble(BRK_HOOK_DISABLE)
    brkState.hookInstalled = false
  end
end

function doa6lr_refill_p1_health()
  doa6lr_assert_offline()
  write_p1_health(lastP1)
end

function doa6lr_refill_p1_break()
  doa6lr_assert_offline()
  if lastP1 &gt; 0 then
    write_p1_break(lastP1, readSmallInteger(lastP1 + 0x582))
  end
end

function doa6lr_drain_p2_break()
  doa6lr_assert_offline()
  write_p2_break(lastP2)
end

-- Auto-attach &amp; periodic fighter pointer refresh timer
if doa6lr_timer then doa6lr_timer.destroy() end
doa6lr_timer = createTimer(nil, true)
doa6lr_timer.Interval = 250
doa6lr_timer.OnTimer = function(t)
  local pid = getProcessIDFromProcessName(TARGET_PROC)
  if not pid or pid == 0 then
    initialized = false
    lastP1, lastP2 = 0, 0
    dmgState.hookInstalled = false
    brkState.hookInstalled = false
    return
  end

  if getOpenedProcessID() ~= pid then
    initialized = false
    lastP1, lastP2 = 0, 0
    dmgState.hookInstalled, dmgState.p1_inf, dmgState.p2_ohko = false, false, false
    brkState.hookInstalled, brkState.p1_max, brkState.p2_empty = false, false, false
    openProcess(pid)
  end

  if not initialized then
    pcall(doa6lr_init)
    return
  end

  pcall(doa6lr_update_fighters)
  if not doa6lr_isOffline() then return end

  if lastP1 &gt; 0 then
    if dmgState.p1_inf and readInteger(lastP1 + 0x1758) ~= 0 then
      pcall(write_p1_health, lastP1)
    end
    if brkState.p1_max then
      local cur = readSmallInteger(lastP1 + 0x580)
      local mx = readSmallInteger(lastP1 + 0x582)
      if cur and mx and mx &gt; 0 and cur &lt; mx then
        pcall(write_p1_break, lastP1, mx)
      end
    end
  end
  if brkState.p2_empty and lastP2 &gt; 0 then
    local cur = readSmallInteger(lastP2 + 0x580)
    if cur and cur &gt; 0 then
      pcall(write_p2_break, lastP2)
    end
  end
end
</LuaScript>
</CheatTable>
